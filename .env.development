# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connections
MONGODB_URI=mongodb://mongo:27017/sokogate
REDIS_URL=redis://redis:6379
POSTGRES_URI=postgresql://sokogate:sokogate@postgres:5432/sokogate

# Kafka Configuration
KAFKA_BROKERS=kafka:9092

# MinIO / S3-compatible Storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=sokogate_access
MINIO_SECRET_KEY=sokogate_secret_key_change_in_production
MINIO_BUCKET=sokogate-artifacts
MINIO_USE_SSL=false

# JWT Authentication
JWT_SECRET=sokogate-os-dev-secret-change-in-production
JWT_REFRESH_SECRET=sokogate-os-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# API Keys (to be filled in)
HUGGINGFACE_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here

# QMe Configuration
QME_DB_PATH=/app/data/qme.db
QME_DASHBOARD_PORT=8080

# Logging
LOG_LEVEL=debug
LOG_DIR=/app/logs

# Frontend URL (for CORS and password reset links)
FRONTEND_URL=http://localhost:5173
