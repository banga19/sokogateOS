{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel-static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "src/index.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/src/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run build:frontend",
  "installCommand": "npm install --ignore-scripts"
}