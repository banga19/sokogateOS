# Vercel Environment Variables

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# MongoDB Atlas Connection
MONGODB_URI=

# JWT Secret (for fallback/custom admin tokens)
JWT_SECRET=

# Other API Keys (if needed)
OPENAI_API_KEY=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_HOST=

# Sentry (for error monitoring)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Firebase (for Firebase auth - optional, as we are using Clerk in production)
FIREBASE_SERVICE_ACCOUNT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PROJECT_ID=