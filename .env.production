# Server Configuration
PORT=3000
NODE_ENV=production

# Database Connections
MONGODB_URI=mongodb://mongo:27017/sokogate
REDIS_URL=redis://redis:6379
POSTGRES_URI=postgresql://sokogate:sokogate@postgres:5432/sokogate

# Kafka Configuration
KAFKA_BROKERS=kafka:9092

# MinIO / S3-compatible Storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=${MINIO_ACCESS_KEY}
MINIO_SECRET_KEY=${MINIO_SECRET_KEY}
MINIO_BUCKET=sokogate-artifacts
MINIO_USE_SSL=false

# JWT Authentication - MUST be set in production
JWT_SECRET=${JWT_SECRET}
JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET}
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# API Keys
HUGGINGFACE_API_KEY=${HUGGINGFACE_API_KEY}
OPENAI_API_KEY=${OPENAI_API_KEY}

# QMe Configuration
QME_DB_PATH=/app/data/qme.db
QME_DASHBOARD_PORT=8080

# Logging
LOG_LEVEL=info
LOG_DIR=/app/logs

# Frontend URL (for CORS and password reset links)
FRONTEND_URL=https://app.sokogate.com
