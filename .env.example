# =============================================================================
# SokogateOS — Environment Configuration
# =============================================================================
# Copy this file to .env (or .env.development for local dev) and fill in your values.
# NEVER commit .env files to version control.
# =============================================================================

# ---- Server ----
NODE_ENV=development
PORT=3000
HOST=localhost

# ---- Security (REQUIRED in production) ----
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-this-to-another-random-64-char-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=12

# ---- MongoDB ----
MONGODB_URI=mongodb://localhost:27017/sokogateos

# ---- PostgreSQL ----
POSTGRES_USER=sokogate
POSTGRES_PASSWORD=sokogate
POSTGRES_DB=sokogate
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Kafka ----
KAFKA_BROKERS=localhost:9092

# ---- MinIO (S3-compatible storage) ----
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=sokogate_access
MINIO_ROOT_PASSWORD=sokogate_secret_key_change_in_production
MINIO_BUCKET=sokogateos-recordings

# ---- Frontend ----
FRONTEND_URL=http://localhost:5173

# ---- Twilio (WhatsApp / SMS) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_SMS_NUMBER=

# ---- M-Pesa (Daraja API) ----
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_ENV=sandbox

# ---- WATI.io (WhatsApp Business) ----
WATI_API_KEY=
WATI_BASE_URL=https://app.wati.io/api/v1

# ---- PostHog (Analytics) ----
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# ---- Cloudflare ----
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=

# ---- Apify (Web Scraping & Data Enrichment) ----
APIFY_API_KEY=

# ---- Composio (Agent Tool Integration — 200+ SaaS tools) ----
COMPOSIO_API_KEY=

# ---- OpenAI / LangChain ----
OPENAI_API_KEY=

# ---- Sentry (Error Tracking) ----
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ERROR_SAMPLE_RATE=1.0

# ---- SEO ----
SITE_URL=https://sokogateos.com
BING_WEBSMASTER_TOOLS_API_KEY=
BING_SITE_URL=

# ---- QMe Task Runner ----
QME_DB_PATH=./data/qme.db
QME_DASHBOARD_PORT=8080

# ---- Storage / Uploads ----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ---- Email (SMTP) ----
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USER=
EMAIL_PASS=

# ---- Feature Flags ----
ENABLE_VOICE_INTERFACE=false
ENABLE_OFFLINE_MODE=false
ENABLE_AI_FEEDBACK_LOOP=true

# ---- Monitoring ----
LOG_LEVEL=debug
LOG_DIR=./logs
